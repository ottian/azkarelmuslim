# بيتعمل تلقائي بـ install.sh. متشيرش الملف ده مع حد.

# الدومين (مثلًا radio.example.com) علشان HTTPS. لو مفيش دومين سيبها :80
SITE_ADDRESS=:80
# الدومين أو الـ IP العام
PUBLIC_HOST=localhost
# إيميل لشهادة HTTPS (Let's Encrypt)
ACME_EMAIL=admin@localhost

STATION_NAME=إذاعة أذكار المسلم
BITRATE_KBPS=64
ICECAST_MAX_LISTENERS=500

ICECAST_SOURCE_PASSWORD=change-me
ICECAST_ADMIN_PASSWORD=change-me
